# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin. Defaults to https://seotecnico.dev.br when unset.
NEXT_PUBLIC_DOMAIN=

# ── Indexing fail-safe ───────────────────────────────────────────────────────
# The site sends noindex/nofollow and "Disallow: /" unless this is exactly
# "true". Set it only in the real production environment on Vercel.
SITE_INDEXABLE=

# ── Analytics ────────────────────────────────────────────────────────────────
# GTM web container id (GTM-XXXXXXX). GTM only mounts when set.
NEXT_PUBLIC_GTM_ID=

# ── Google Search Console ────────────────────────────────────────────────────
# HTML-tag verification token (not needed if the domain property is verified
# via DNS, which is the plan — kept for flexibility).
GOOGLE_SITE_VERIFICATION=

# ── Chrome UX Report API ─────────────────────────────────────────────────────
# Key for the CWV checker tool (CLAUDE.md §5.3). Server-side only: it is read
# in a Route Handler and must NEVER carry the NEXT_PUBLIC_ prefix, or it ends
# up extractable from the client bundle and the quota is anyone's to burn.
# Restrict the key to the Chrome UX Report API alone in the Cloud Console —
# an unrestricted key reaches every API enabled in the same project.
# Real value lives only in Vercel env vars and a local .env.local (§14).
CRUX_API_KEY=
