# Dependencies
node_modules/

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Environment — never commit secrets
.env*
!.env.example

# Vercel
.vercel/

# Test artifacts
test-results/
playwright-report/
.lighthouseci/

# Editor / local tooling — project skills are versioned (docs/skills.md)
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/content-page/
!.claude/skills/english-version/
!.claude/skills/portuguese-style/

# OS
.DS_Store
Thumbs.db

# Coverage reports
coverage/

# Crawl audits: raw crawl data stays local (CLAUDE.md §14 — publish aggregates,
# not raw datasets). Scripts and each crawl's summary.json are versioned.
audits/.venv/
audits/crawl-*/**
!audits/crawl-*/summary*.json

# Outside-in case studies (docs/proposals/case-studies-content.md §3): the
# targets file names real sites and the raw output carries hosts and paths, so
# both stay local. Only the codes-only summary.json of each run is versioned.
audits/case-studies/*.local.json
audits/case-studies/soft404-*/**
!audits/case-studies/soft404-*/summary*.json

# Fixture of scripts/next-notfound-status.mjs: the build output and the files
# next build generates next to it stay local; app/, configs and result.json are
# versioned.
audits/next-notfound-status/.next/
audits/next-notfound-status/next-env.d.ts

# scripts/template-anatomy.mjs: the downloaded HTML, the per-target manifest and
# the detail file carry hosts, paths and sentences. Only summary.json (codes and
# numbers) is versioned.
audits/case-studies/template-anatomy-*/**
!audits/case-studies/template-anatomy-*/summary*.json

# scripts/sitemap-audit.mjs: raw.json carries hosts, sitemap URLs and paths.
# Only summary.json (codes, rounded counts, shares) is versioned.
audits/case-studies/sitemap-audit-*/**
!audits/case-studies/sitemap-audit-*/summary*.json

# scripts/raw-vs-rendered.mjs: raw.json carries hosts, paths, titles and links.
# Only summary.json (codes, page kinds, rounded counts) is versioned.
audits/case-studies/raw-vs-rendered-*/**
!audits/case-studies/raw-vs-rendered-*/summary*.json
